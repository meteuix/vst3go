package main

import (
	"math"
	"testing"

	"github.com/th-release/vst3go/pkg/plugintest"
)

func TestGain(t *testing.T) {
	inst := plugintest.New(t, effect{})
	inst.Set(paramGain, -6)
	in := plugintest.Channels(2, plugintest.Constant(4800, 0.5))
	out := inst.Render(in, 2)
	// After the 20 ms ramp the output sits 6 dB below the input.
	if got := out[0][len(out[0])-1]; math.Abs(float64(got)-0.5*math.Pow(10, -6.0/20)) > 1e-4 {
		t.Fatalf("output %g after -6 dB", got)
	}
}

func TestBypass(t *testing.T) {
	inst := plugintest.New(t, effect{})
	inst.Set(paramGain, -60)
	inst.Set(paramBypass, 1)
	out := inst.Render(plugintest.Channels(2, plugintest.Constant(512, 0.5)), 2)
	if got := plugintest.Peak(out[1]); got != 0.5 {
		t.Fatalf("bypassed peak %g", got)
	}
}

func TestState(t *testing.T) {
	inst := plugintest.New(t, effect{})
	inst.Set(paramGain, 6)
	state, err := inst.State()
	if err != nil {
		t.Fatal(err)
	}
	restored := plugintest.New(t, effect{})
	if err := restored.SetState(state); err != nil {
		t.Fatal(err)
	}
	if got := restored.Plain(paramGain); math.Abs(got-6) > 1e-9 {
		t.Fatalf("restored gain %g", got)
	}
}
